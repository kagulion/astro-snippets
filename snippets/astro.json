{
  "Astro Component": {
    "prefix": "a-comp",
    "body": [
      "---",
      "interface Props {",
      "  ${1:title}: ${2:string};",
      "}",
      "",
      "const { ${1:title} } = Astro.props;",
      "---",
      "",
      "<${3:div}>",
      "  $0",
      "</${3:div}>"
    ],
    "description": "Basic Astro component with TypeScript Props interface"
  },

  "Astro Component with Slot": {
    "prefix": "a-comp-slot",
    "body": [
      "---",
      "interface Props {",
      "  ${1:class?: string;}",
      "}",
      "",
      "const { ${2:class: className} } = Astro.props;",
      "---",
      "",
      "<${3:div} class={className}>",
      "  <slot />",
      "</${3:div}>"
    ],
    "description": "Astro component with Props interface and default slot"
  },

  "Astro Page": {
    "prefix": "a-page",
    "body": [
      "---",
      "$1",
      "---",
      "",
      "<!doctype html>",
      "<html lang=\"${2:en}\">",
      "  <head>",
      "    <meta charset=\"UTF-8\" />",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
      "    <title>${3:Document}</title>",
      "  </head>",
      "  <body>",
      "    $0",
      "  </body>",
      "</html>"
    ],
    "description": "Complete HTML5 Astro page structure"
  },

  "Astro Page with Layout": {
    "prefix": "a-page-layout",
    "body": [
      "---",
      "import Layout from '@/layouts/Layout.astro';",
      "---",
      "",
      "<Layout title=\"${1:Page Title}\">",
      "  $0",
      "</Layout>"
    ],
    "description": "Astro page wrapped in a Layout component"
  },

  "Astro Layout": {
    "prefix": "a-layout",
    "body": [
      "---",
      "interface Props {",
      "  title?: string;",
      "  description?: string;",
      "}",
      "",
      "const {",
      "  title = '${1:My Astro Site}',",
      "  description = '${2:Site description}',",
      "} = Astro.props;",
      "---",
      "",
      "<!doctype html>",
      "<html lang=\"${3:en}\">",
      "  <head>",
      "    <meta charset=\"UTF-8\" />",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
      "    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />",
      "    <meta name=\"generator\" content={Astro.generator} />",
      "    <title>{title}</title>",
      "    <meta name=\"description\" content={description} />",
      "  </head>",
      "  <body>",
      "    <slot />",
      "  </body>",
      "</html>"
    ],
    "description": "Base Astro Layout with SEO metadata and slot"
  },

  "Astro Layout with Dark Mode": {
    "prefix": "a-layout-theme",
    "body": [
      "---",
      "interface Props {",
      "  title?: string;",
      "  description?: string;",
      "}",
      "",
      "const {",
      "  title = '${1:My Astro Site}',",
      "  description = '${2:Site description}',",
      "} = Astro.props;",
      "---",
      "",
      "<!doctype html>",
      "<html lang=\"${3:en}\">",
      "  <head>",
      "    <meta charset=\"UTF-8\" />",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
      "    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />",
      "    <meta name=\"generator\" content={Astro.generator} />",
      "    <title>{title}</title>",
      "    <meta name=\"description\" content={description} />",
      "    <script is:inline>",
      "      const theme = (() => {",
      "        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {",
      "          return localStorage.getItem('theme');",
      "        }",
      "        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';",
      "      })();",
      "      if (theme === 'dark') {",
      "        document.documentElement.classList.add('dark');",
      "      } else {",
      "        document.documentElement.classList.remove('dark');",
      "      }",
      "    </script>",
      "  </head>",
      "  <body class=\"bg-white text-neutral-900 dark:bg-neutral-900 dark:text-neutral-100\">",
      "    <slot />",
      "  </body>",
      "</html>"
    ],
    "description": "Layout component with inline dark mode detection"
  },

  "Astro Prerender": {
    "prefix": "a-prerender",
    "body": [
      "export const prerender = ${1|true,false|};"
    ],
    "description": "Astro prerender toggle for SSG / SSR"
  },

  "Astro getStaticPaths": {
    "prefix": "a-gsp",
    "body": [
      "export async function getStaticPaths() {",
      "  return [",
      "    { params: { ${1:slug}: '${2:value}' } },",
      "  ];",
      "}"
    ],
    "description": "Astro getStaticPaths function for dynamic SSG routes"
  },

  "Astro Dynamic Page with getStaticPaths": {
    "prefix": "a-page-gsp",
    "body": [
      "---",
      "import type { InferGetStaticPropsType, InferGetStaticParamsType } from 'astro';",
      "",
      "export async function getStaticPaths() {",
      "  return [",
      "    {",
      "      params: { ${1:slug}: '${2:example}' },",
      "      props: { ${3:title}: '${4:Example Title}' },",
      "    },",
      "  ];",
      "}",
      "",
      "type Params = InferGetStaticParamsType<typeof getStaticPaths>;",
      "type Props = InferGetStaticPropsType<typeof getStaticPaths>;",
      "",
      "const { ${1:slug} } = Astro.params;",
      "const { ${3:title} } = Astro.props;",
      "---",
      "",
      "<${5:div}>",
      "  <h1>{${3:title}}</h1>",
      "  <p>Slug: {${1:slug}}</p>",
      "  $0",
      "</${5:div}>"
    ],
    "description": "Dynamic Astro route with getStaticPaths and inferred types"
  },

  "Astro Content Collection Page": {
    "prefix": "a-page-collection",
    "body": [
      "---",
      "import { getCollection, render } from 'astro:content';",
      "import type { InferGetStaticPropsType } from 'astro';",
      "",
      "export async function getStaticPaths() {",
      "  const ${1:posts} = await getCollection('${2:blog}');",
      "  return ${1:posts}.map((entry) => ({",
      "    params: { slug: entry.id },",
      "    props: { entry },",
      "  }));",
      "}",
      "",
      "type Props = InferGetStaticPropsType<typeof getStaticPaths>;",
      "const { entry } = Astro.props;",
      "const { Content } = await render(entry);",
      "---",
      "",
      "<h1>{entry.data.${3:title}}</h1>",
      "<Content />"
    ],
    "description": "Dynamic route for Content Collection entry with render"
  },

  "Astro Default Slot": {
    "prefix": "a-slot",
